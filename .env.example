# Public URL of the deployed site (used for canonical URLs, sitemap, OG and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://kanpur-ki-kahaani.vercel.app

# Optional: Google Analytics 4 measurement ID. Leave empty to disable GA.
NEXT_PUBLIC_GA_ID=

# Optional: Meta (Facebook) Pixel ID. Leave empty to disable the pixel.
NEXT_PUBLIC_META_PIXEL_ID=
