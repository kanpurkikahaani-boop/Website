# ── Site ─────────────────────────────────────────────────────────────
# Public URL of the deployed site (canonical URLs, sitemap, OG, JSON-LD, RSS)
NEXT_PUBLIC_SITE_URL=https://kanpurkikahaani.site

# ── Supabase (Project Settings → API) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security — never expose it or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ────────────────────────────────────────────────────────────
# The ONE Google/email account allowed into /admin. Must also be inserted into the `admins` table.
ADMIN_EMAIL=

# ── Secrets (generate each with: openssl rand -hex 32) ───────────────
# Protects GET /api/cron/refresh-news. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
# Signs newsletter unsubscribe links.
UNSUBSCRIBE_SECRET=

# ── Analytics (optional — scripts load only when set) ────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
